Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tMax", "=", "20"}], ",", "beta", ",", "eqOfMotion", ",", 
       "solNeutral", ",", "metricPressureFunc", ",", "x", ",", "xi", ",", 
       "t"}], "}"}], ",", 
     RowBox[{"(*", 
