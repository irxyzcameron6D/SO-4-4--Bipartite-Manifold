Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "t", ",", "a", ",", "rho", ",", "zKin", ",", "zGrav", ",", "zTotal", ",", 
     "plotRedshift", ",", "plotDensity", ",", "combinedPlot"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Lock", " ", "in", " ", "the", " ", "Static", " ", 
    "Parameters"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lookbackMax", "=", "13.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"kinematicH", "=", "0.0"}], ";", 
  RowBox[{"(*", 
   RowBox[{
   "Set", " ", "to", " ", "zero", " ", "to", " ", "isolate", " ", "the", " ", 
    "gravitational", " ", "effect"}], "*)"}], 
  RowBox[{"pastDensity", "=", "8.0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"presentDensity", "=", "0.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"densityDecay", "=", "0.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gravCoupling", "=", "0.05"}], ";"}], "\[IndentingNewLine]", "\n", 
  
  RowBox[{"(*", 
   RowBox[{"2.", " ", "Define", " ", "the", " ", "Functions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "[", "t_", "]"}], ":=", 
   RowBox[{"Exp", "[", 
    RowBox[{"kinematicH", "*", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rho", "[", "t_", "]"}], ":=", 
   RowBox[{"presentDensity", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"pastDensity", "-", "presentDensity"}], ")"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "densityDecay"}], "*", 
       RowBox[{"(", 
        RowBox[{"lookbackMax", "-", "t"}], ")"}]}], "]"}]}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zKin", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"a", "[", "lookbackMax", "]"}], "/", 
     RowBox[{"a", "[", 
      RowBox[{"lookbackMax", "-", "t"}], "]"}]}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zGrav", "[", "t_", "]"}], ":=", 
   RowBox[{"gravCoupling", "*", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"rho", "[", "tau", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"tau", ",", 
        RowBox[{"lookbackMax", "-", "t"}], ",", "lookbackMax"}], "}"}]}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zTotal", "[", "t_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"zKin", "[", "t", "]"}]}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"zGrav", "[", "t", "]"}]}], ")"}]}], "-", "1"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "3.", " ", "Generate", " ", "the", " ", "Individual", " ", "Plots"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotRedshift", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"zKin", "[", "t", "]"}], ",", 
        RowBox[{"zGrav", "[", "t", "]"}], ",", 
        RowBox[{"zTotal", "[", "t", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "lookbackMax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{"Thick", ",", "Black", ",", "Dashed"}], "]"}], ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Thick", ",", 
           RowBox[{"GrayLevel", "[", "0.4", "]"}], ",", "Dotted"}], "]"}], 
         ",", 
         RowBox[{"Directive", "[", 
          RowBox[{"Thick", ",", "Black"}], "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Lookback Distance (BLY)\>\"", ",", 
         "\"\<Observed Redshift (z)\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<z (Kinematic)\>\"", ",", "\"\<z (Gravitational Lag)\>\"", ",", 
         "\"\<z (Total Observed)\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "->", 
       "\"\<Compound Redshift: Decoupling Physical Expansion from Density Lag\
\>\""}], ",", 
      RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotDensity", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"rho", "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "lookbackMax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Thick", ",", "Black"}], "]"}]}], ",", 
      RowBox[{"PlotRange", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"pastDensity", "+", "1"}]}], "}"}]}], ",", 
      RowBox[{"Filling", "->", "Axis"}], ",", 
      RowBox[{"FillingStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Gray", ",", 
         RowBox[{"Opacity", "[", "0.2", "]"}]}], "]"}]}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
        "\"\<Lookback Distance (BLY)\>\"", ",", 
         "\"\<Effective Mass Density of Shells\>\""}], "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "->", 
       "\"\<Pound-Rebka Asymmetry: The Retarded Density Drop-Off\>\""}], ",", 
      
      RowBox[{"ImageSize", "->", "600"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "4.", " ", "Combine", " ", "and", " ", "Export", " ", "as", " ", "a", " ", 
    "Vector", " ", "PDF"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"combinedPlot", "=", 
    RowBox[{"GraphicsColumn", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"plotRedshift", ",", "plotDensity"}], "}"}], ",", 
      RowBox[{"ImageSize", "->", "650"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
  "\"\<pound_rebka_asymmetry.pdf\>\"", ",", "combinedPlot", ",", 
   "\"\<PDF\>\""}], "]"}]}], "Input",
 CellChangeTimes->{{4.002529632628603*^9, 4.002529632630135*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"3e4d357e-2e9e-4a1a-8f1e-8fd95ab067d6"],

Cell[BoxData["\<\"pound_rebka_asymmetry.pdf\"\>"], "Output",
 CellChangeTimes->{{4.0025296376778193`*^9, 4.0025296644474077`*^9}},
 CellLabel->"Out[45]=",ExpressionUUID->"e178f218-afb7-46d2-986d-c2caa2752e1f"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"SystemOpen", "[", "\"\<pound_rebka_asymmetry.pdf\>\"", 
  "]"}]], "Input",
 NumberMarks->False,
 CellLabel->"In[46]:=",ExpressionUUID->"9cfcd6e7-7b6d-4913-9510-df2ee2d90764"]
},
