   RowBox[{
    RowBox[{
     RowBox[{"metricPressure", "[", "xi_", "]"}], ":=", 
     RowBox[{
      RowBox[{"earlyInflation", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "decayRate"}], "*", "xi"}], "]"}]}], "+", 
      "currentAcceleration"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Plot", " ", "the", " ", "geometric", " ", "trace", " ", "of", " ", "a",
        " ", "sub"}], "-", 
      RowBox[{"luminal", " ", "particle"}]}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{
     "The", " ", "xr", " ", "position", " ", "is", " ", "dragged", " ", 
      "outward", " ", "by", " ", "the", " ", "xi", " ", "metric", " ", 
      "pressure"}], "*)"}], 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"metricPressure", "[", "xi", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
