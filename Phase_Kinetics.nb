        "Node", " ", "Harmonic", " ", "Metric", " ", "Pressure", " ", "using",
          " ", "a", " ", "distinct", " ", "localized", " ", "function", " ", 
         "name"}]}], "*)"}], 
      RowBox[{
       RowBox[{"metricPressureFunc", "[", "xiVar_", "]"}], ":=", 
       RowBox[{"baselineExpansion", "+", 
        RowBox[{"node1Amp", "*", 
