            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "initialXr"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "initialBeta"}]}], 
           "}"}], ",", "x", ",", 
          RowBox[{"{", 
           RowBox[{"xi", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}]}], ";", 
