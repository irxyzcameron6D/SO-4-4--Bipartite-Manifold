        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$, Typeset`keyframeActionsQ$$, 
        Typeset`keyframeList$$}, "Body" :> 
      Module[{$CellContext`tMax$ = 
         10, $CellContext`beta$, $CellContext`eqOfMotion$, \
$CellContext`solNeutral$, $CellContext`solLike$, $CellContext`solOpposite$, \
$CellContext`soiNeutral$, $CellContext`soiLike$, $CellContext`soiOpposite$, \
$CellContext`x$, $CellContext`xi$, $CellContext`t$}, $CellContext`beta$[
           Pattern[$CellContext`x, 
            Blank[]], 
           Pattern[$CellContext`xi, 
            Blank[]]] := 
         Derivative[1][$CellContext`x][$CellContext`xi]; $CellContext`metric[
           Pattern[$CellContext`xi$, 
            Blank[]]] := $CellContext`metricPressure$$ 
           Exp[(-0.1) $CellContext`xi$] + 0.1; $CellContext`eqOfMotion$[
           Pattern[$CellContext`chargeSign$, 
            Blank[]]] := 
         Derivative[
           2][$CellContext`x$][$CellContext`xi$] == \
$CellContext`metric[$CellContext`xi$] - $CellContext`gForce$$ ((
             1 + $CellContext`beta$[$CellContext`x$, \
$CellContext`xi$]^2)/$CellContext`x$[$CellContext`xi$]^2) + \
$CellContext`chargeSign$ $CellContext`eForce$$ ((
              1 - $CellContext`beta$[$CellContext`x$, \
$CellContext`xi$]^2)/$CellContext`x$[$CellContext`xi$]^2); \
$CellContext`solNeutral$ = Quiet[
           NDSolveValue[{
             $CellContext`eqOfMotion$[
             0], $CellContext`x$[0] == $CellContext`initialXr$$, 
             Derivative[1][$CellContext`x$][
              0] == $CellContext`initialBeta$$}, $CellContext`x$, \
