Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Redshift", " ", 
      RowBox[{"Decoupler", ":", 
       RowBox[{"Pound", "-", 
        RowBox[{"Rebka", " ", "Asymmetry"}]}]}]}], "&"}], " ", "Density", " ",
     "Lag"}], "*)"}], 
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "t", ",", "a", ",", "rho", ",", "zKin", ",", "zGrav", ",", "zTotal"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"1.", " ", "Kinematic", " ", "Scale", " ", "Factor", " ", 
        RowBox[{"(", 
         RowBox[{"Physical", " ", "Expansion"}], ")"}]}], "*)"}], 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"a", 
          RowBox[{"(", "t", ")"}], " ", "represents", " ", "the", " ", 
          "physical", " ", "stretching", " ", "of", " ", 
          RowBox[{"space", ".", "If"}], " ", "kinematicH"}], "=", "0"}], ",", 
        
        RowBox[{"the", " ", "universe", " ", "is", " ", "physically", " ", 
         RowBox[{"static", "."}]}]}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"a", "[", "t_", "]"}], ":=", 
        RowBox[{"Exp", "[", 
         RowBox[{"kinematicH", "*", "t"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"2.", " ", "Retarded", " ", "Density", " ", "Gradient"}], 
        "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "The", " ", "universe", " ", "was", " ", "much", " ", "denser", " ", 
         "in", " ", "the", " ", "past", " ", 
         RowBox[{
          RowBox[{"(", "source", ")"}], ".", "This"}], " ", "models", " ", 
         "the", " ", "density", " ", "dropping", " ", "over", " ", "the", " ", 
         RowBox[{"photon", "'"}], "s", " ", "travel", " ", 
         RowBox[{"time", "."}]}], "*)"}], 
       RowBox[{
        RowBox[{"rho", "[", "t_", "]"}], ":=", 
        RowBox[{"presentDensity", "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"pastDensity", "-", "presentDensity"}], ")"}], "*", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "densityDecay"}], "*", 
            RowBox[{"(", 
             RowBox[{"lookbackMax", "-", "t"}], ")"}]}], "]"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"3.", " ", "Kinematic", " ", "Redshift", " ", "Component"}], 
        "*)"}], 
       RowBox[{"(*", 
        RowBox[{"Standard", " ", 
         RowBox[{"Doppler", "/", "metric"}], " ", "stretching", " ", 
         RowBox[{"effect", "."}]}], "*)"}], 
       RowBox[{
        RowBox[{"zKin", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", "lookbackMax", "]"}], "/", 
          RowBox[{"a", "[", 
           RowBox[{"lookbackMax", "-", "t"}], "]"}]}], "-", "1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "4.", " ", "Gravitational", " ", "Redshift", " ", "Component", " ", 
         RowBox[{"(", 
          RowBox[{"The", " ", "Asymmetry"}], ")"}]}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "The", " ", "photon", " ", "loses", " ", "massive", " ", "energy", 
          " ", "climbing", " ", "out", " ", "of", " ", "the", " ", "dense", 
          " ", "past"}], ",", 
         RowBox[{
         "but", " ", "gains", " ", "very", " ", "little", " ", "falling", " ",
           "into", " ", "the", " ", "sparse", " ", "present", " ", 
          RowBox[{"field", "."}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"zGrav", "[", "t_", "]"}], ":=", 
        RowBox[{"gravCoupling", "*", 
         RowBox[{"Integrate", "[", 
          RowBox[{
           RowBox[{"rho", "[", "tau", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"tau", ",", 
             RowBox[{"lookbackMax", "-", "t"}], ",", "lookbackMax"}], "}"}]}],
           "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"5.", " ", "Total", " ", "Observed", " ", "Redshift"}], 
        "*)"}], 
       RowBox[{"(*", 
        RowBox[{"The", " ", "compound", " ", "observational", " ", "effect"}],
         "*)"}], 
       RowBox[{
        RowBox[{"zTotal", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"zKin", "[", "t", "]"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            RowBox[{"zGrav", "[", "t", "]"}]}], ")"}]}], "-", "1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Render", " ", "the", " ", "Decoupling", " ", "Plots"}], 
        "*)"}], 
       RowBox[{"Column", "[", 
        RowBox[{"{", 
         RowBox[{"(*", 
          RowBox[{"Plot", " ", 
           RowBox[{"A", ":", 
            RowBox[{"Redshift", " ", "Components"}]}]}], "*)"}], 
         RowBox[{
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"zKin", "[", "t", "]"}], ",", 
              RowBox[{"zGrav", "[", "t", "]"}], ",", 
              RowBox[{"zTotal", "[", "t", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0", ",", "lookbackMax"}], "}"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Directive", "[", 
                RowBox[{"Thick", ",", "Blue", ",", "Dashed"}], "]"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Thick", ",", "Red", ",", "Dotted"}], "]"}], ",", 
               RowBox[{"Directive", "[", 
                RowBox[{"Thick", ",", "Purple"}], "]"}]}], "}"}]}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Lookback Distance (Billions of Light Years)\>\"", ",", 
               "\"\<Observed Redshift (z)\>\""}], "}"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{
