      RowBox[{"PlotStyle", "->", "Thick"}]}], "]"}]}], ",", 
   RowBox[{"(*", 
    RowBox[{"The", " ", "Sliders"}], "*)"}], 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "earlyInflation", ",", "10", ",", 
       "\"\<Early Universe Steepness (A)\>\""}], "}"}], ",", "1", ",", "20"}],
     "}"}], ",", 
   RowBox[{"{", 
