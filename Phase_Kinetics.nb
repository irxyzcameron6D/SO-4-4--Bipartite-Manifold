Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"phase_kinetics", ".", 
    RowBox[{"m", ":", 
     RowBox[{"SO", 
      RowBox[{"(", 
       RowBox[{"4", ",", "4"}], ")"}], " ", "3", "D", " ", "Bipartite", " ", 
      "M\[ODoubleDot]bius", " ", "Braid"}]}]}], "*)"}], 
  RowBox[{"Manipulate", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "bulkSphere", ",", "matterTrace", ",", "antimatterTrace", ",", "k"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"Using", " ", "a", " ", "half"}], "-", 
         RowBox[{"integer", " ", "frequency", " ", 
          RowBox[{"(", 
           RowBox[{"freq", "/", "2"}], ")"}], " ", "forces", " ", "the", " ", 
          "M\[ODoubleDot]bius", " ", 
          RowBox[{"topology", ".", "A"}], " ", "full", " ", "4", "\[Pi]", " ",
           "rotation", " ", "is", " ", "required", " ", "to", " ", "close", 
          " ", "the", " ", "loop"}]}], ",", 
        RowBox[{
         RowBox[{
         "splitting", " ", "naturally", " ", "into", " ", "two", " ", "2", 
          "\[Pi]", " ", "out"}], "-", "of", "-", 
         RowBox[{"phase", " ", "halves", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Matter", " ", "and", " ", "Antimatter"}], ")"}], 
           "."}]}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"k", "=", 
        RowBox[{"freq", "/", "2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Parametric", " ", "equations", " ", "for", " ", "the", " ", "wave", 
         " ", "wrapped", " ", "around", " ", "the", " ", "bulk", " ", 
         "sphere"}], "*)"}], 
       RowBox[{
        RowBox[{"x", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"bulkRadius", "+", 
           RowBox[{"waveAmplitude", "*", 
            RowBox[{"Cos", "[", 
             RowBox[{"braidTwist", "*", "t"}], "]"}]}]}], ")"}], "*", 
         RowBox[{"Cos", "[", "t", "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", "*", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"y", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"bulkRadius", "+", 
           RowBox[{"waveAmplitude", "*", 
            RowBox[{"Cos", "[", 
             RowBox[{"braidTwist", "*", "t"}], "]"}]}]}], ")"}], "*", 
         RowBox[{"Sin", "[", "t", "]"}], "*", 
         RowBox[{"Cos", "[", 
          RowBox[{"k", "*", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"z", "[", "t_", "]"}], ":=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"bulkRadius", "+", 
           RowBox[{"waveAmplitude", "*", 
            RowBox[{"Cos", "[", 
             RowBox[{"braidTwist", "*", "t"}], "]"}]}]}], ")"}], "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"k", "*", "t"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"The", " ", "central", " ", "6", 
         RowBox[{"D", "/", "8"}], "D", " ", "Bulk", " ", 
         RowBox[{"(", "Translucent", ")"}]}], "*)"}], 
       RowBox[{"bulkSphere", "=", 
        RowBox[{"Graphics3D", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Opacity", "[", "0.3", "]"}], ",", "LightGray", ",", 
           RowBox[{"Sphere", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "bulkRadius"}], 
            "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"The", " ", "First", " ", "2", "\[Pi]", " ", 
         RowBox[{"Cycle", ":", 
          RowBox[{"Matter", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"+", "mi"}], "/", "Real"}], " ", "Dominant"}], 
            ")"}]}]}]}], "*)"}], 
       RowBox[{"matterTrace", "=", 
        RowBox[{"ParametricPlot3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"y", "[", "t", "]"}], ",", 
            RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "0", ",", 
            RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"Thickness", "[", "0.015", "]"}], ",", "Blue", ",", 
             RowBox[{"Specularity", "[", 
              RowBox[{"White", ",", "50"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"{", "\"\<Matter Wave (+mi Phase)\>\"", "}"}]}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"The", " ", "Second", " ", "2", "\[Pi]", " ", 
         RowBox[{"Cycle", ":", 
          RowBox[{"Antimatter", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "mi"}], "/", "Imaginary"}], " ", "Dominant"}], 
            ")"}]}]}]}], "*)"}], 
       RowBox[{"antimatterTrace", "=", 
        RowBox[{"ParametricPlot3D", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"y", "[", "t", "]"}], ",", 
            RowBox[{"z", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"2", " ", "Pi"}], ",", 
            RowBox[{"4", " ", "Pi"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"Thickness", "[", "0.015", "]"}], ",", "Red", ",", 
             RowBox[{"Specularity", "[", 
              RowBox[{"White", ",", "50"}], "]"}]}], "]"}]}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"{", "\"\<Antimatter Wave (-mi Phase)\>\"", "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Combine", " ", "and", " ", "render", " ", "the", " ", "entangled", 
