          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<SO(4,4) Spin-Paired Bipartite Braid\>\"", ",", "White", ",", 
            "14", ",", "Bold"}], "]"}]}]}], "]"}]}]}], "]"}], ",", 
