              0] == $CellContext`initialBeta$$}, $CellContext`x$, \
{$CellContext`xi$, 0, $CellContext`tMax$}]]; $CellContext`solOpposite$ = Quiet[
           NDSolveValue[{
             $CellContext`eqOfMotion$[-1], $CellContext`x$[
              0] == $CellContext`initialXr$$, 
             Derivative[1][$CellContext`x$][0] == $CellContext`initialBeta$$, 
             
             
             WhenEvent[$CellContext`x$[$CellContext`xi$] <= 0.01, 
              "StopIntegration"]}, $CellContext`x$, {$CellContext`xi$, 
             0, $CellContext`tMax$}]]; $CellContext`soiRadius[
           Pattern[$CellContext`sol$, 
            Blank[]], 
           Pattern[$CellContext`xi$, 
            Blank[]]] := ($CellContext`gForce$$ (1 + 
            Derivative[1][$CellContext`sol$][$CellContext`xi$]^2))/(
          1 + $CellContext`metric[$CellContext`xi$] \
$CellContext`sol$[$CellContext`xi$]); Show[
          
          Plot[{{$CellContext`solNeutral$[$CellContext`xi$] - \
$CellContext`soiRadius[$CellContext`solNeutral$, $CellContext`xi$], \
$CellContext`solNeutral$[$CellContext`xi$] + \
$CellContext`soiRadius[$CellContext`solNeutral$, $CellContext`xi$]}, \
{$CellContext`solLike$[$CellContext`xi$] - \
$CellContext`soiRadius[$CellContext`solLike$, $CellContext`xi$], \
$CellContext`solLike$[$CellContext`xi$] + \
$CellContext`soiRadius[$CellContext`solLike$, $CellContext`xi$]}, \
{$CellContext`solOpposite$[$CellContext`xi$] - \
$CellContext`soiRadius[$CellContext`solOpposite$, $CellContext`xi$], \
$CellContext`solOpposite$[$CellContext`xi$] + \
$CellContext`soiRadius[$CellContext`solOpposite$, $CellContext`xi$]}}, \
{$CellContext`xi$, 0, $CellContext`tMax$}, 
