Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tMax", "=", "10"}], ",", "beta", ",", "eqOfMotion", ",", 
       "solNeutral", ",", "solLike", ",", "solOpposite", ",", "soiNeutral", ",",
        "soiLike", ",", "soiOpposite", ",", "x", ",", "xi", ",", "t"}], "}"}],
      ",", 
     RowBox[{"(*", 
      RowBox[{"Normalized", " ", "velocity"}], "*)"}], 
     RowBox[{
      RowBox[{
       RowBox[{"beta", "[", 
        RowBox[{"x_", ",", "xi_"}], "]"}], ":=", 
       RowBox[{
        RowBox[{"x", "'"}], "[", "xi", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Background", " ", "metric", " ", "expansion", " ", "function"}], 
       "*)"}], 
      RowBox[{
       RowBox[{"metric", "[", "xi_", "]"}], ":=", 
       RowBox[{
        RowBox[{"metricPressure", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "0.1"}], "*", "xi"}], "]"}]}], "+", "0.1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Equation", " ", "of", " ", "Motion"}], "*)"}], 
      RowBox[{
       RowBox[{"eqOfMotion", "[", "chargeSign_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "xi", "]"}], "==", 
        RowBox[{
         RowBox[{"metric", "[", "xi", "]"}], "-", 
         RowBox[{"(", 
          RowBox[{"gForce", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               RowBox[{"beta", "[", 
                RowBox[{"x", ",", "xi"}], "]"}], "^", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"x", "[", "xi", "]"}], "^", "2"}]}]}], ")"}], "+", 
         RowBox[{"(", 
          RowBox[{"chargeSign", "*", "eForce", "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{
               RowBox[{"beta", "[", 
                RowBox[{"x", ",", "xi"}], "]"}], "^", "2"}]}], ")"}], "/", 
            RowBox[{
             RowBox[{"x", "[", "xi", "]"}], "^", "2"}]}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Solvers", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Same", " ", "as", " ", "before"}], ",", 
          RowBox[{
           RowBox[{
           "using", " ", "Quiet", " ", "to", " ", "suppress", " ", 
            "singularity", " ", "warnings", " ", "at", " ", "xr"}], "->", 
           "0"}]}], ")"}]}], "*)"}], 
      RowBox[{"solNeutral", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"eqOfMotion", "[", "0", "]"}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "initialXr"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "initialBeta"}]}], 
           "}"}], ",", "x", ",", 
          RowBox[{"{", 
           RowBox[{"xi", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solLike", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"eqOfMotion", "[", "1", "]"}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "initialXr"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "initialBeta"}]}], 
           "}"}], ",", "x", ",", 
          RowBox[{"{", 
           RowBox[{"xi", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"solOpposite", "=", 
       RowBox[{"Quiet", "@", 
        RowBox[{"NDSolveValue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"eqOfMotion", "[", 
             RowBox[{"-", "1"}], "]"}], ",", 
            RowBox[{
             RowBox[{"x", "[", "0", "]"}], "==", "initialXr"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "'"}], "[", "0", "]"}], "==", "initialBeta"}], ",", 
            RowBox[{"WhenEvent", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"x", "[", "xi", "]"}], "<=", "0.01"}], 
              ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", "x", ",", 
          RowBox[{"{", 
           RowBox[{"xi", ",", "0", ",", "tMax"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Dynamic", " ", "Sphere", " ", "of", " ", "Influence", " ", 
